# Neon CLI escribe las conexiones en el .env.local de la raíz, que también carga el backend.
# DATABASE_URL es la conexión agrupada de runtime; Alembic usa DATABASE_URL_UNPOOLED si existe.
DATABASE_URL=postgresql+psycopg://fletes:fletes@localhost:5432/fletes
ENVIRONMENT=dev
# Solo para demo local: no habilitar en redes compartidas ni despliegues.
DEV_ASSUME_ADMIN=true
