# URL pública del backend FastAPI, usada desde el navegador.
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL interna del backend FastAPI, usada por Server Components y Server Actions.
# - En Docker Compose, docker-compose.yml ya define API_URL=http://backend:8000.
# - Si corrés `npm run dev` directamente en el host, usá http://localhost:8000.
# Si no se define, el servidor prueba http://backend:8000 y luego http://localhost:8000.
API_URL=http://localhost:8000
